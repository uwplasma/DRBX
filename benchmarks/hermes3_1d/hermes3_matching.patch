diff --git a/src/neutral_parallel_diffusion.cxx b/src/neutral_parallel_diffusion.cxx
index 0eee96d9..4b83b2e6 100644
--- a/src/neutral_parallel_diffusion.cxx
+++ b/src/neutral_parallel_diffusion.cxx
@@ -118,7 +118,19 @@ void NeutralParallelDiffusion::transform_impl(GuardedOptions& state) {
     }
 
     // Pressure-diffusion coefficient
-    Field3D Dn = dneut * Tn / (AA * nu);
+    Field3D vth2 = floor(Tn, neutral_temperature_floor) / AA;
+    if ((max_mean_free_path > 0) or (nn_cross_section > 0)) {
+      // SD1D closure: nu += vth / min(1/(Nn sigma_nn), max_mean_free_path)
+      Field3D inv_lambda = 0.0;
+      if (nn_cross_section > 0) {
+        inv_lambda = floor(Nn, 1e-5) * nn_cross_section;
+      }
+      if (max_mean_free_path > 0) {
+        inv_lambda = floor(inv_lambda, 1. / max_mean_free_path);
+      }
+      nu += sqrt(vth2) * inv_lambda;
+    }
+    Field3D Dn = dneut * vth2 / nu;
     Dn.applyBoundary("dirichlet_o2");
     mesh->communicate(Dn);
 
